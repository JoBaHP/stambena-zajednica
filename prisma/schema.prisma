generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(RESIDENT)
  phone     String?
  unit      String?  // broj stana npr. "12", "PP1"
  // Kvadratura stana u m². Iz nje se racuna vlasnicki udeo, pa i tezina glasa i
  // kvorum na glasanju (Zakon o stanovanju odluke vezuje za udeo, ne za broj glava).
  area        Decimal? @db.Decimal(8, 2)
  notifyEmail Boolean @default(true)
  active      Boolean @default(true)
  lastLoginAt DateTime?
  lastSeenAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  announcements       Announcement[]
  polls               Poll[]
  votes               Vote[]
  transactions        Transaction[]
  maintenanceRequests MaintenanceRequest[]
  requestComments     RequestComment[]
  tasks               Task[]
  archiveDocuments    ArchiveDocument[]
  tenderVotes         TenderVote[]
}

enum Role {
  MANAGER
  RESIDENT
}

model AccessRequest {
  id           String              @id @default(cuid())
  email        String
  name         String
  phone        String?
  unit         String?
  message      String?
  status       AccessRequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── FINANSIJE ───────────────────────────────────────────────────────────────

model TransactionCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  type         CategoryType
  color        String        @default("#6366f1")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id           String               @id @default(cuid())
  type         TransactionType
  amount       Decimal              @db.Decimal(10, 2)
  description  String
  date         DateTime             @db.Date
  categoryId   String?
  category     TransactionCategory? @relation(fields: [categoryId], references: [id])
  referenceNum String?
  notes        String?
  // Red u tabeli iz kog je stavka uvezena, npr. "MART/1" (kartica/redni broj).
  // Po njemu se ponovni uvoz prepoznaje kao izmena a ne kao nova stavka.
  sourceRef    String?              @unique
  documents    Document[]
  createdById  String
  createdBy    User                 @relation(fields: [createdById], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── PP INSPEKCIJE ───────────────────────────────────────────────────────────

model PPInspection {
  id             String           @id @default(cuid())
  title          String
  inspectionDate DateTime         @db.Date
  nextDueDate    DateTime?        @db.Date
  result         InspectionResult
  inspector      String?
  notes          String?
  documents      Document[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum InspectionResult {
  PASSED
  FAILED
  CONDITIONAL
}

// ─── INVESTICIJE ─────────────────────────────────────────────────────────────

model Investment {
  id          String           @id @default(cuid())
  title       String
  description String?
  budget      Decimal          @db.Decimal(10, 2)
  spent       Decimal          @default(0) @db.Decimal(10, 2)
  status      InvestmentStatus @default(PLANNED)
  startDate   DateTime?        @db.Date
  endDate     DateTime?        @db.Date
  documents   Document[]
  tender      Tender?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum InvestmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── DOKUMENTI ───────────────────────────────────────────────────────────────

// Prilog uz zapis. `fileId` je id fajla na Google Drive-u; `url` je zaostao iz
// vremena Vercel Blob-a i ostaje opcion zbog starih redova.
model Document {
  id             String        @id @default(cuid())
  name           String
  url            String?
  fileId         String?
  size           Int?
  mimeType       String?
  transactionId  String?
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ppInspectionId String?
  ppInspection   PPInspection? @relation(fields: [ppInspectionId], references: [id], onDelete: Cascade)
  investmentId   String?
  investment     Investment?   @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  requestId      String?
  request        MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([requestId])
}

// ─── ZAHTEVI ZA INTERVENCIJE ────────────────────────────────────────────────

model MaintenanceRequest {
  id          String           @id @default(cuid())
  title       String
  description String
  category    RequestCategory
  status      RequestStatus    @default(SUBMITTED)
  priority    RequestPriority  @default(NORMAL)
  location    String?
  resolution  String?
  resolvedAt  DateTime?
  reporterId  String
  reporter    User             @relation(fields: [reporterId], references: [id])
  comments    RequestComment[]
  photos      Document[]
  // Predlog AI trijaze: kategorija, prioritet, izvodjac i obrazlozenje.
  // Samo predlog za upravnika — ne menja sam zapis.
  aiTriage    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum RequestCategory {
  PLUMBING
  ELECTRICAL
  ELEVATOR
  HEATING
  CLEANING
  STRUCTURAL
  OTHER
}

enum RequestStatus {
  SUBMITTED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model RequestComment {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime           @default(now())
}

// ─── DIGITALNA ARHIVA ──────────────────────────────────────────────────────

model ArchiveDocument {
  id           String          @id @default(cuid())
  title        String
  description  String?
  category     ArchiveCategory
  year         Int
  fileName     String
  fileId       String
  fileSize     Int
  mimeType     String
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([category])
  @@index([createdAt])
}

enum ArchiveCategory {
  MINUTES
  CONTRACT
  INVOICE
  REPORT
  REGULATION
  OTHER
}

// ─── KALENDAR OBAVEZA ──────────────────────────────────────────────────────

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime       @db.Date
  category    TaskCategory   @default(OTHER)
  status      TaskStatus     @default(PENDING)
  recurrence  TaskRecurrence @default(NONE)
  completedAt DateTime?
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([dueDate])
}

enum TaskCategory {
  INSPECTION
  MAINTENANCE
  PAYMENT
  MEETING
  CONTRACT
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum TaskRecurrence {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

// ─── KONTAKTI ───────────────────────────────────────────────────────────────

model Contact {
  id        String          @id @default(cuid())
  name      String
  phone     String
  category  ContactCategory
  note      String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ContactCategory {
  EMERGENCY
  MANAGEMENT
  MAINTENANCE
}

// ─── OBAVESTENJA ────────────────────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  priority    Priority  @default(NORMAL)
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  documents   Document[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Priority {
  NORMAL
  URGENT
}

// ─── GLASANJE ────────────────────────────────────────────────────────────────

model Poll {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      PollStatus @default(DRAFT)
  // Koliki deo ukupnog vlasnickog udela (u %) opcija mora da skupi da bi odluka
  // bila doneta. 50 za redovne odluke, 66 za one koje traze dvotrecinsku vecinu.
  requiredShare Int      @default(50)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  options     PollOption[]
  votes       Vote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  Vote[]
}

model Vote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voterId  String
  voter    User       @relation(fields: [voterId], references: [id])
  votedAt  DateTime   @default(now())

  @@unique([pollId, voterId])
}

// ─── TENDERI ─────────────────────────────────────────────────────────────────

model Tender {
  id           String        @id @default(cuid())
  investmentId String        @unique
  title        String
  description  String?
  status       TenderStatus  @default(OPEN)
  selectedId   String?
  aiComparison String?
  closedAt     DateTime?
  createdAt    DateTime      @default(now())

  investment   Investment    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  offers       TenderOffer[]
  votes        TenderVote[]
}

enum TenderStatus {
  OPEN
  CLOSED
}

model TenderOffer {
  id          String       @id @default(cuid())
  tenderId    String
  company     String
  description String?
  price       Decimal?     @db.Decimal(10, 2)
  fileName    String?
  fileId      String?
  mimeType    String?
  aiSummary   String?
  createdAt   DateTime     @default(now())

  tender      Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  votes       TenderVote[]
}

model TenderVote {
  id        String      @id @default(cuid())
  tenderId  String
  offerId   String
  userId    String
  createdAt DateTime    @default(now())

  tender    Tender      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  offer     TenderOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenderId, userId])
}

// ─── OGLEDANJE NA DRIVE ─────────────────────────────────────────────────────

// Veza izmedju zapisa u bazi i njegovog citljivog dokumenta na Google Drive-u.
// entityId je cuid zapisa, ili "_all" za zbirne registre (kontakti, stanari).
model DriveMirror {
  id          String    @id @default(cuid())
  entity      String
  entityId    String
  fileId      String?
  fileName    String?
  folderId    String?
  contentHash String?
  syncedAt    DateTime?
  lastError   String?
  attempts    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([entity, entityId])
  @@index([entity])
}
